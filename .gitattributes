# Normalise line endings so the repo is identical on Windows, macOS and Linux.
# Without this, a Windows contributor commits CRLF and every file looks changed
# to everyone else.
* text=auto eol=lf

# Windows batch files must keep CRLF. This is not cosmetic: cmd.exe seeks
# through a running .cmd by byte offset, and with LF-only endings those offsets
# land mid-line, so `call :label` fails with "The system cannot find the batch
# label specified" - and it fails only for labels far enough into the file,
# which makes it look intermittent. tests/test_launchers.py enforces it.
*.cmd text eol=crlf

# The POSIX launcher must keep LF or the shebang breaks on Linux and macOS.
# It is btc.sh, not btc: Explorer hides known extensions, so an extensionless
# `btc` next to `btc.cmd` shows up as two identical entries and the unrunnable
# one sorts first.
btc.sh text eol=lf

# Binary, never diffed or normalised.
*.sqlite binary
*.png binary
*.jpg binary
