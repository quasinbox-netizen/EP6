.venv/
__pycache__/
*.py[cod]
.env
data/raw/**
data/processed/**
!data/raw/events.csv
!data/raw/manual/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
# Analysis results are version-controlled - they are the product of this repo.
# Left out are the artefacts one command can regenerate: lab.sqlite (11 MB)
# and features.csv (3.9 MB) would bloat the history on every run, and
# `run.py all` recreates them.
!data/processed/RESULTS.md
!data/processed/event_study_*.csv
!data/processed/hypothesis_scan.csv
!data/processed/out_of_sample.csv
!data/processed/control_*.csv
!data/processed/backtest_comparison.csv
!data/processed/walk_forward.csv
!data/processed/walk_forward_folds.csv
!data/processed/forecast_folds.csv
!data/processed/forecast_pooled.csv
!data/processed/forecast_calibration.csv
!data/processed/specification_curve.csv
!data/processed/specification_summary.csv
# The coverage verdict and the quoted interval, but NOT the 870 KB walk they
# were computed from: `range --calibrate` regenerates that in a few minutes,
# and the two small files are what a reader actually needs to see.
!data/processed/range_calibration_*.csv
!data/processed/range_forecast_*.csv
# The sizing comparison, but not the 4035-day volatility series behind it:
# `sizing --refresh` rebuilds that in a few minutes.
!data/processed/sizing_comparison.csv
!data/processed/sizing_today.csv
.pytest_cache/
.streamlit/secrets.toml
*.log
.pytest-tmp/

# Agent tooling, not project code. The Streamlit skill under .claude/skills is
# third-party content with its own licence, and both entries are symlinks that
# would be dangling for anyone who clones this.
.agents/
.claude/skills/
