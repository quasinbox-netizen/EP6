.venv/
__pycache__/
*.py[cod]
.env
data/raw/**
data/processed/**
!data/raw/events.csv
!data/raw/manual/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
# Analysis results are version-controlled - they are the product of this repo.
# Left out are the artefacts one command can regenerate: lab.sqlite (11 MB)
# and features.csv (3.9 MB) would bloat the history on every run, and
# `run.py all` recreates them.
!data/processed/RESULTS.md
!data/processed/event_study_*.csv
!data/processed/hypothesis_scan.csv
!data/processed/out_of_sample.csv
!data/processed/control_*.csv
!data/processed/backtest_comparison.csv
!data/processed/walk_forward.csv
!data/processed/walk_forward_folds.csv
.pytest_cache/
.streamlit/secrets.toml
*.log
.pytest-tmp/
