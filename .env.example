# Copy to .env and fill in. The .env file is NEVER committed (see .gitignore).

# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Without it only the market-based macro proxies work (DXY, the rate curve).
# With it you get real M2, industrial production, the Fed funds rate and
# unemployment, fetched as first releases rather than revised values.
FRED_API_KEY=

# Optional - no price source currently needs a key. Binance, Bitstamp and
# Coinbase all expose public OHLC endpoints.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
