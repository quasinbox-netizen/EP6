# Skopiuj do .env i uzupełnij. Plik .env NIGDY nie trafia do repo (.gitignore).

# Darmowy klucz: https://fred.stlouisfed.org/docs/api/api_key.html
# Bez niego działa tylko makro z Yahoo Finance (DXY, SPX, stopy rynkowe).
FRED_API_KEY=

# Opcjonalne — obecnie żadne ze źródeł cen nie wymaga klucza
# (Bitstamp i Coinbase mają publiczne endpointy OHLC).
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
